---
// Rediseña: lámina técnica oscura, azul eléctrico, elevación de un marco arriostrado.
interface Props { orientation: 'landscape' | 'portrait' }
const { orientation } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
const cond = "font-family:'Bricolage Grotesque Variable',sans-serif;font-stretch:75%;font-weight:800";
---
{orientation === 'landscape' ? (
  <svg viewBox="0 0 320 200" class="h-full w-full" aria-hidden="true">
    <defs>
      <pattern id={`rd-grid-${uid}`} width="12" height="12" patternUnits="userSpaceOnUse"><path d="M12 0H0V12" fill="none" stroke="#2060ff" stroke-opacity=".09" stroke-width=".5"/></pattern>
    </defs>
    <rect width="320" height="200" fill="#0a0e17"/>
    <rect width="320" height="200" fill={`url(#rd-grid-${uid})`}/>
    <rect width="320" height="16" fill="#0d1220"/>
    <text x="12" y="11" fill="#f2f5fa" style={cond} font-size="7">REDISEÑA</text>
    <g fill="#b8c2d0" font-size="4.5"><text x="168" y="10.5">Servicios</text><text x="194" y="10.5">Proyectos</text><text x="221" y="10.5">Proceso</text><text x="245" y="10.5">Contacto</text></g>
    <rect x="270" y="4" width="40" height="8" rx="2" fill="#2060ff"/><text x="274" y="9.6" fill="#fff" font-size="3.8" font-weight="600">Solicitar cotización</text>
    <g fill="#f2f5fa" style={cond} font-size="15">
      <text x="14" y="52">ESTRUCTURAS QUE</text><text x="14" y="67">SE REVISAN, SE</text><text x="14" y="82">CONSTRUYEN Y SE</text><text x="14" y="97" fill="#2060ff">DEFIENDEN</text>
    </g>
    <rect x="14" y="106" width="118" height="3" rx="1.5" fill="#b8c2d0" opacity=".35"/>
    <rect x="14" y="112" width="96" height="3" rx="1.5" fill="#b8c2d0" opacity=".35"/>
    <rect x="14" y="124" width="52" height="11" rx="2.5" fill="#2060ff"/><text x="19" y="131.4" fill="#fff" font-size="4.6" font-weight="600">Solicitar cotización</text>
    <rect x="70" y="124" width="38" height="11" rx="2.5" fill="none" stroke="#fff" stroke-opacity=".2"/><text x="77" y="131.4" fill="#f2f5fa" font-size="4.6" font-weight="600">Ver proyectos</text>
    <g transform="translate(176 34)">
      <g stroke="#5b8cff" stroke-opacity=".35" stroke-dasharray="4 2 1 2" stroke-width=".6"><line x1="10" y1="0" x2="10" y2="110"/><line x1="52" y1="0" x2="52" y2="110"/><line x1="94" y1="0" x2="94" y2="110"/><line x1="136" y1="0" x2="136" y2="110"/></g>
      <g class="rd-draw" stroke="#dce4f2" stroke-width="3" stroke-linecap="square"><line x1="10" y1="104" x2="10" y2="34"/><line x1="52" y1="104" x2="52" y2="34"/><line x1="94" y1="104" x2="94" y2="34"/><line x1="136" y1="104" x2="136" y2="34"/><line x1="8" y1="70" x2="138" y2="70"/><line x1="8" y1="35" x2="138" y2="35"/></g>
      <g stroke="#2060ff" stroke-width="1.4"><line x1="54" y1="102" x2="92" y2="72"/><line x1="92" y1="102" x2="54" y2="72"/><line x1="54" y1="68" x2="92" y2="37"/><line x1="92" y1="68" x2="54" y2="37"/></g>
      <g fill="#2060ff"><circle cx="10" cy="70" r="1.6"/><circle cx="52" cy="70" r="1.6"/><circle cx="94" cy="70" r="1.6"/><circle cx="136" cy="70" r="1.6"/><circle cx="10" cy="35" r="1.6"/><circle cx="52" cy="35" r="1.6"/><circle cx="94" cy="35" r="1.6"/><circle cx="136" cy="35" r="1.6"/></g>
      <g stroke="#5b8cff" stroke-width=".7" fill="none"><line x1="10" y1="16" x2="136" y2="16"/><path d="M10 17v13M31 17v13M52 17v13M73 17v13M94 17v13M115 17v13M136 17v13"/></g>
      <line x1="0" y1="104" x2="146" y2="104" stroke="#3a4b6b"/>
      <g fill="#8a99ad" font-size="4"><text x="27" y="118">6,00</text><text x="69" y="118">6,00</text><text x="111" y="118">6,00</text></g>
    </g>
    <g transform="translate(14 158)">
      <rect width="292" height="30" fill="#ffffff" fill-opacity=".04" stroke="#fff" stroke-opacity=".12" stroke-width=".5"/>
      <g fill="#8a99ad" font-size="3.6" font-weight="600"><text x="6" y="10">NORMATIVA</text><text x="80" y="10">PROYECTOS</text><text x="150" y="10">EXPERIENCIA</text><text x="222" y="10">ALCANCE</text></g>
      <g fill="#f2f5fa" style={cond} font-size="7"><text x="6" y="22">NCH VIGENTE</text><text x="80" y="22" fill="#5b8cff">+40</text><text x="150" y="22" fill="#5b8cff">5+ AÑOS</text><text x="222" y="22">CHILE Y EXTERIOR</text></g>
    </g>
  </svg>
) : (
  <svg viewBox="0 0 180 390" class="h-full w-full" aria-hidden="true">
    <defs><pattern id={`rd-gridp-${uid}`} width="12" height="12" patternUnits="userSpaceOnUse"><path d="M12 0H0V12" fill="none" stroke="#2060ff" stroke-opacity=".1" stroke-width=".6"/></pattern></defs>
    <rect width="180" height="390" fill="#0a0e17"/><rect width="180" height="390" fill={`url(#rd-gridp-${uid})`}/>
    <rect y="0" width="180" height="40" fill="#0d1220"/>
    <text x="14" y="30" fill="#f2f5fa" style={cond} font-size="12">REDISEÑA</text>
    <path d="M150 23h16M150 28h16M150 33h16" stroke="#f2f5fa" stroke-width="1.6"/>
    <g fill="#f2f5fa" style={cond} font-size="16"><text x="14" y="80">ESTRUCTURAS QUE</text><text x="14" y="98">SE REVISAN Y SE</text><text x="14" y="116" fill="#2060ff">DEFIENDEN</text></g>
    <rect x="14" y="134" width="150" height="4" rx="2" fill="#b8c2d0" opacity=".35"/><rect x="14" y="142" width="120" height="4" rx="2" fill="#b8c2d0" opacity=".35"/>
    <rect x="14" y="156" width="152" height="20" rx="4" fill="#2060ff"/><text x="90" y="169" text-anchor="middle" fill="#fff" font-size="7.5" font-weight="600">Solicitar cotización</text>
    <g transform="translate(20 196)">
      <g stroke="#dce4f2" stroke-width="3.4"><line x1="6" y1="120" x2="6" y2="30"/><line x1="70" y1="120" x2="70" y2="30"/><line x1="134" y1="120" x2="134" y2="30"/><line x1="4" y1="75" x2="136" y2="75"/><line x1="4" y1="31" x2="136" y2="31"/></g>
      <g stroke="#2060ff" stroke-width="1.6"><line x1="9" y1="118" x2="67" y2="78"/><line x1="67" y1="118" x2="9" y2="78"/><line x1="73" y1="72" x2="131" y2="34"/><line x1="131" y1="72" x2="73" y2="34"/></g>
      <line x1="-6" y1="120" x2="146" y2="120" stroke="#3a4b6b"/>
      <g stroke="#5b8cff" stroke-width=".8" fill="none"><line x1="6" y1="10" x2="134" y2="10"/><path d="M6 11v15M38 11v15M70 11v15M102 11v15M134 11v15"/></g>
    </g>
  </svg>
)}
