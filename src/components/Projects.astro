---
// Showcase: cada caso es una fila con el dispositivo a un lado y el case study al otro.
// Las filas alternan lado en escritorio; en móvil el dispositivo va primero.
import DeviceFrame from './DeviceFrame.astro';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import CodeXml from '@lucide/astro/icons/code-xml';
import { projects } from '../data/projects';
---
<section id="proyectos" class="relative border-t border-line py-24 sm:py-32" aria-labelledby="proyectos-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <h2 id="proyectos-title" class="font-display text-[clamp(2rem,4vw,3rem)] font-semibold leading-[1.05] tracking-[-0.03em]">
        Proyectos en producción
      </h2>
      <p class="mt-4 text-lg text-muted text-pretty">
        Cada caso parte de un problema concreto de negocio: qué había que resolver, cómo lo resolví y con qué tecnologías.
      </p>
    </div>

    <div class="mt-20 flex flex-col gap-28 sm:gap-36">
      {projects.map((p, i) => (
        <article class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-14" aria-labelledby={`case-${p.slug}`}>
          <div class:list={['min-w-0 lg:col-span-7', i % 2 === 1 && 'lg:order-2']}>
            <DeviceFrame project={p} />
          </div>

          <div class:list={['min-w-0 lg:col-span-5', i % 2 === 1 && 'lg:order-1']}>
            <p class="text-sm text-muted">{p.kind}, {p.year}</p>
            <h3 id={`case-${p.slug}`} class="mt-2 font-display text-[clamp(1.6rem,2.6vw,2.15rem)] font-semibold leading-tight tracking-[-0.025em]">
              {p.title}
            </h3>

            <dl class="mt-7 space-y-5 border-l border-line pl-5">
              <div>
                <dt class="font-semibold text-fg">Problema</dt>
                <dd class="mt-1 text-muted text-pretty">{p.problem}</dd>
              </div>
              <div>
                <dt class="font-semibold text-fg">Solución</dt>
                <dd class="mt-1 text-muted text-pretty">{p.solution}</dd>
              </div>
              {p.outcome && (
                <div>
                  <dt class="font-semibold text-signal">Resultado</dt>
                  <dd class="mt-1 text-fg text-pretty">{p.outcome}</dd>
                </div>
              )}
            </dl>

            <ul class="mt-7 flex flex-wrap gap-2" aria-label="Tecnologías">
              {p.stack.map((t) => (
                <li class="rounded-md border border-line bg-ink-2 px-2.5 py-1 font-mono text-[0.75rem] text-fg/85">{t}</li>
              ))}
            </ul>

            {(p.url || p.repo) && (
              <div class="mt-8 flex flex-wrap gap-5 text-[0.95rem] font-semibold">
                {p.url && (
                  <a href={p.url} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-signal hover:text-fg">
                    Abrir sitio en vivo <ArrowUpRight class="size-4" aria-hidden="true" />
                  </a>
                )}
                {p.repo && (
                  <a href={p.repo} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-muted hover:text-fg">
                    <CodeXml class="size-4" aria-hidden="true" /> Ver código
                  </a>
                )}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
